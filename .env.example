# Variabili d'ambiente richieste da SDQ-1
# Copia questo file come .env e inserisci le chiavi reali
# NON committare mai .env — è già in .gitignore

# --- Provider LLM (almeno uno obbligatorio) ---

# Anthropic (Claude) — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Google Gemini — https://aistudio.google.com/apikey
GOOGLE_API_KEY=AIza...

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# DeepSeek — https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-...

# Perplexity — https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=pplx-...

# --- Provider locale (opzionale) ---
# Ollama non richiede API key — installare da https://ollama.ai
# Il modello default è llama3.2: ollama pull llama3.2

# --- Telegram (notifiche autonome ogni mattina) ---
# 1. Crea bot: apri @BotFather → /newbot → copia il token
# 2. Ottieni chat_id: scrivi un msg al bot, poi vai su:
#    https://api.telegram.org/bot<TOKEN>/getUpdates → copia "id" dal campo "chat"
TELEGRAM_BOT_TOKEN=<token da @BotFather>
TELEGRAM_CHAT_ID=<il tuo chat_id numerico>

# --- Configurazione opzionale ---
# SDQ1_CONFIG_PATH=/path/to/custom/sdq1.yaml
# SDQ1_LOG_LEVEL=INFO

# Atelier: archivio clienti privato e immagini (segreti solo sul server)
PERFUME_ARCHIVE_PASSWORD=
PERFUME_ARCHIVE_SECRET=
PERFUME_IMAGES_ENABLED=0
OPENAI_IMAGE_MODEL=gpt-image-2
PERFUME_IMAGES_DAILY_LIMIT=10

# --- R3∞ Synology NAS backend ---
# Usare esclusivamente variabili d'ambiente / secret manager.
# NON inserire mai credenziali reali in GitHub.
# Richiede WebDAV Server Synology raggiungibile via HTTPS.
R3_NAS_BASE_URL=https://nas.example.com:5006
R3_NAS_USERNAME=
R3_NAS_PASSWORD=
R3_NAS_ROOT=/R3_INFINITY
