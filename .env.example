# Flight Hunter Configuration — EXAMPLE (fill in your tokens)

# Telegram Bots
TELEGRAM_PROTOCOLLO_ROSSO_TOKEN=your_token_here
TELEGRAM_PROTOCOLLO_ROSSO_MODE=polling
TELEGRAM_ASSISTENTE_RAFFAELLO_TOKEN=your_raffaello_token_here
TELEGRAM_ASSISTENTE_RAFFAELLO_MODE=webhook

# Chat ID (Claudio's private chat)
TELEGRAM_CHAT_ID=your_chat_id_here

# Flight Hunter Settings
FLIGHT_HUNTER_ALERT_BOT=PROTOCOLLO_ROSSO
FLIGHT_HUNTER_ALERT_ENABLED=true
FLIGHT_HUNTER_ALERT_THRESHOLD_DEFAULT=45
FLIGHT_HUNTER_DEPARTURE_CITIES=MXP,BRU,FCO,VCE,GVA,ROM
FLIGHT_HUNTER_SEARCH_DAYS=14

# Google Drive
DRIVE_FLIGHTS_TRACKER_FOLDER=Agorà Digitale — SDQ-1
DRIVE_TRACKER_SHEET_ID=1ZCK-XpUeclNcvQ5UdA_payjEemMiq-LTHVq0SiKGyHQ

# Optional: Travelpayouts API
TRAVELPAYOUTS_TOKEN=

# --- Gateway OmniRoute (opzionale, consigliato per failover multi-provider) ---
# API OpenAI-compatible. Default locale: http://127.0.0.1:20128/v1
OMNIROUTE_BASE_URL=http://127.0.0.1:20128/v1
OMNIROUTE_API_KEY=
# Solo per loopback locale se OmniRoute REQUIRE_API_KEY=false.
# Non usare per endpoint remoti.
OMNIROUTE_LOCAL_NO_AUTH=0

# Optional: Kiwi/Tequila API
KIWI_API_KEY=
