+def request_stream(body, timeout):
+    """Collect the local SSE response without waiting for a buffered upstream body."""
+    opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))
+    headers = {"Authorization": "Bearer " + gateway_key(), "Content-Type": "application/json"}
+    req = urllib.request.Request(BASE_URL + "/v1/chat/completions",
+                                 data=json.dumps(body).encode("utf-8"), headers=headers)
+    answer, model, usage, finished = [], MODEL, {}, False
+    with opener.open(req, timeout=timeout) as response:
+        status = response.status
+        for raw in response:
+            line = raw.decode("utf-8").strip()
+            if not line.startswith("data:"):
+                continue
+            payload = line[5:].strip()
+            if payload == "[DONE]":
+                finished = True
+                break
+            chunk = json.loads(payload)
+            if chunk.get("error"):
+                raise RuntimeError("Local streaming provider returned an error")
+            model = chunk.get("model") or model
+            usage = chunk.get("usage") or usage
+            for choice in chunk.get("choices", []):
+                content = choice.get("delta", {}).get("content")
+                if content:
+                    answer.append(content)
+                if choice.get("finish_reason") == "length":
+                    raise RuntimeError("Local generation reached its output limit")
+        if not finished:
+            raise RuntimeError("Local stream ended without completion")
+    return status, {"model": model, "choices": [{"message": {"content": "".join(answer)}}], "usage": usage}
+
+
