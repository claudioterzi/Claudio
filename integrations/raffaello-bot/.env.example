# Token da @BotFather. Non committare .env.
TELEGRAM_BOT_TOKEN=123456789:AAReplaceWithYourRealToken
# alias accettato: BOT_TOKEN=...
DATABASE_PATH=protocollo.db
PERSISTENCE_PATH=protocollo.persistence
CONVERSATION_TIMEOUT=1800
LOG_LEVEL=INFO
# Ponte verso SDQ-1 a sei agenti, quando esiste.
# Vuota = risponde il nucleo locale. Piena = /ask inoltra al motore esterno;
# se il ponte cade, la risposta lo dichiara (mai spacciare il nucleo per i sei).
# SDQ1_URL=https://sdq1-esempio.onrender.com/ask
# SDQ1_TIMEOUT=8
# Network Event v1 (twin Supereroe) — secrets solo in Render/DM, mai in chat.
# NODE_ID=protocollo-rosso
# NETWORK_SECRET=
# NETWORK_PEERS=https://supereroe-bot.onrender.com

# Raffaello 2 — numeric Telegram user IDs explicitly authorized by the owner.
# Missing/empty = new private dialogue disabled; existing registries stay intact.
RAFFAELLO_ALLOWED_USERS=
RAFFAELLO_SITE_URL=https://claudio-ebon.vercel.app
# Same random secret (at least 32 characters) in Render and Vercel. Never in git.
RAFFAELLO_BRIDGE_SECRET=
# Vercel Protection Bypass for Automation, only if the site requires it.
RAFFAELLO_VERCEL_BYPASS_SECRET=
# NETWORK_SECRET is now required for /ask and /network/v1/*.
