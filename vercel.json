{
  "version": 2,
  "builds": [
    {
      "src": "tarocchi_web.py",
      "use": "@vercel/python",
      "config": {
        "maxDuration": 60,
        "includeFiles": "{studio/parfums/**,public/formule/organo-*.json}"
      }
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/.*",
      "status": 404,
      "headers": {
        "Cache-Control": "no-store",
        "X-Robots-Tag": "noindex, nofollow, noarchive"
      }
    }
  ]
}
